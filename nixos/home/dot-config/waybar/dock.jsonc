{
  "name": "dock",
  "layer": "top",
  "position": "bottom",
  "mode": "hide",
  "start_hidden": true,
  "on-sigusr1": "show",
  "on-sigusr2": "hide",
  "exclusive": false,
  "height": 72,
  "fixed-center": true,
  "margin-bottom": 10,
  "modules-center": ["wlr/taskbar"],
  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 32,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  }
}
